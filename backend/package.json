{
  "name": "crm-hrms-backend",
  "version": "1.0.0",
  "description": "Node.js Express & PostgreSQL Backend API Server for CRM, HRMS, and Attendance Kiosk Engine",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch-path=index.js --watch-path=routes --watch-path=controllers --watch-path=db --watch-path=middleware --watch-path=services --watch-path=utils --watch-path=config --watch-path=validators index.js",
    "setup": "node setup_hrms.js && node setup_crm.js",
    "setup:hrms": "node setup_hrms.js",
    "setup:crm": "node setup_crm.js",
    "migrate": "node setup_hrms.js && node setup_crm.js",
    "db:migrate": "node setup_hrms.js && node setup_crm.js",
    "db:setup": "node setup_hrms.js && node setup_crm.js",
    "db:seed": "node setup_hrms.js && node setup_crm.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "openai": "^7.10.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}

{
  "name": "crm-hrms-backend",
  "version": "1.0.0",
  "description": "Node.js Express & PostgreSQL Backend API Server for CRM, HRMS, and Attendance Kiosk Engine",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "setup": "node setup_hrms.js && node setup_crm.js",
    "setup:hrms": "node setup_hrms.js",
    "setup:crm": "node setup_crm.js",
    "migrate": "node setup_hrms.js && node setup_crm.js",
    "db:migrate": "node setup_hrms.js && node setup_crm.js",
    "db:setup": "node setup_hrms.js && node setup_crm.js",
    "db:seed": "node setup_hrms.js && node setup_crm.js",
    "test": "node tests/run_all_tests.js",
    "test:all": "node tests/run_all_tests.js",
    "test:unit": "node tests/01_unit_testing_suite.js",
    "test:integration": "node tests/02_integration_testing_suite.js",
    "test:uat": "node tests/03_acceptance_uat_testing_suite.js",
    "test:smoke": "node tests/04_smoke_testing_suite.js",
    "test:sanity": "node tests/05_sanity_testing_suite.js",
    "test:regression": "node tests/06_regression_testing_suite.js",
    "test:e2e": "node tests/07_e2e_testing_suite.js",
    "test:component": "node tests/08_component_testing_suite.js",
    "test:interface": "node tests/09_interface_testing_suite.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "openai": "^7.10.0",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}

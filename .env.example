# ==============================================================================
# Enterprise CRM + HRMS Unified System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or backend/.env and adjust credentials as appropriate.
#
# QUICK START:
#   Docker: docker compose up -d
#   Local:  cd backend && npm run setup && npm run dev
#           cd frontend && npm run dev
# ==============================================================================

# Backend Service
PORT=5000
NODE_ENV=development
JWT_SECRET=erp_crm_hrms_jwt_secret_2025

# ------------------------------------------------------------------------------
# HRMS Database (Friend 2: Employees, Payroll, Attendance, Leaves, Documents, Finance)
# Local Port Default: 5432 (or 5434 when connecting to the Docker HRMS container from host)
# Container Hostname: postgres_hrms (port 5432)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=HRMS

# ------------------------------------------------------------------------------
# CRM Database (Friend 1: Leads, Deals, Customers, Purchases, Vendors, Inventory)
# Local Port Default: 5432 (or 5435 when connecting to the Docker CRM container from host)
# Container Hostname: postgres_crm (port 5432)
# ------------------------------------------------------------------------------
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_USER=postgres
CRM_DB_PASSWORD=postgres
CRM_DB_NAME=crm

# ------------------------------------------------------------------------------
# Frontend Vite Dev Server (Optional overrides)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:5000/ws
